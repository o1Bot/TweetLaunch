# apps/perps — perps.o1bot.exchange
#
# Only ONE variable is required. Every other value below has a working default
# that points at Lighter mainnet, so set them only to move off it.
#
# On Vercel, NEXT_PUBLIC_* values are baked into the bundle at BUILD time, not
# read at runtime: changing one needs a redeploy, not just a restart.
#
# Locally, next.config.ts walks up to the repo root and loads the root .env, so
# a value set there already reaches this app — you do not need a second copy.


# ---------------------------------------------------------------- required

# Privy app that handles "sign in with X" and "connect a wallet".
# Shared with the main site so a session started at o1bot.exchange carries over.
# perps.o1bot.exchange must be added to that app's allowed domains, and
# localhost:3001 too if you want the flow to work in development.
NEXT_PUBLIC_PRIVY_APP_ID=


# ---------------------------------------------------------------- optional

# Give this domain its own Privy app instead of sharing the main one. Setting
# it means logins stop being shared between the two sites, which is the only
# reason to do it.
# NEXT_PUBLIC_PRIVY_APP_ID_PERPS=

# The venue. Defaults to Lighter mainnet — 214 tradeable perp markets, the RWA
# set, USDC margin. Point these at the Robinhood instance together, never one
# at a time, or the REST reads and the streams describe different venues.
# NEXT_PUBLIC_LIGHTER_API=https://mainnet.zklighter.elliot.ai
# NEXT_PUBLIC_LIGHTER_WS=wss://mainnet.zklighter.elliot.ai/stream

# Quote asset, shown in symbols and order labels. Mainnet is USDC; the
# Robinhood instance is USDG.
# NEXT_PUBLIC_LIGHTER_QUOTE=USDC

# L2 chain id the signer signs with. 304 is verified against mainnet. A wrong
# value here does not fail loudly — every signature is simply rejected.
# NEXT_PUBLIC_LIGHTER_L2_CHAIN_ID=304

# Absolute base for link previews and metadata. Defaults to
# https://perps.o1bot.exchange; set it on preview deployments so the cards
# point at the deployment rather than production.
# PERPS_SITE_URL=

# Extra ISO 3166-1 alpha-2 codes to block at the eligibility gate, comma
# separated, on top of the fourteen the venue's terms already name. Use this to
# add a country without waiting for a deploy — it cannot remove one.
# RESTRICTED_COUNTRIES_EXTRA=
