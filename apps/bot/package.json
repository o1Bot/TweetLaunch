{
  "name": "@o1bot/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "pnpm --filter @o1bot/db generate && tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@o1bot/db": "workspace:*",
    "@o1bot/executor": "workspace:*",
    "@o1bot/market": "workspace:*",
    "@o1bot/parser": "workspace:*",
    "@o1bot/shared": "workspace:*",
    "@o1bot/wallet": "workspace:*",
    "@o1bot/x": "workspace:*",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
