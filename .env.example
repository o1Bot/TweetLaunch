# o1bot.exchange — copy to .env (never commit .env). Every process reads this file.
# The bot boots in DRY_RUN=true by default: parse, validate, simulate, but never broadcast or reply.

# ── Safety ────────────────────────────────────────────────────────────
DRY_RUN=true
SITE_URL=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/o1bot
# memory (default, single process) or redis (BullMQ; needs REDIS_URL).
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ── Privy (dashboard.privy.io) ────────────────────────────────────────
# Same app for the web front end and the bot. Enable: Login with X (Twitter),
# Embedded wallets (Ethereum), and Delegated actions (server signing consent).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# ── X / Twitter (developer.x.com) ─────────────────────────────────────
# Bearer: read mentions. App user tokens: post replies as @o1bot_exchange
# (Read+Write; regenerate the access token AFTER enabling Write).
X_BEARER_TOKEN=
X_APP_KEY=
X_APP_SECRET=
X_APP_ACCESS_TOKEN=
X_APP_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=o1bot_exchange
# Mentions poll interval in ms. 90 s keeps a Basic-tier app inside its 10 requests / 15 min budget.
X_POLL_MS=90000

# ── Anthropic (parser) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-4-6 when empty.
PARSER_MODEL=

# ── IPFS (Pinata) ─────────────────────────────────────────────────────
PINATA_JWT=

# ── Chain (v1 = Robinhood Chain, id 4663) ─────────────────────────────
# Leave empty to rotate through public RPCs (publicnode, ordofi, the chain's
# own endpoint). Set a paid RPC for production; public ones refuse archive
# log queries and some ISPs intercept rpc.mainnet.chain.robinhood.com.
RPC_ROBINHOOD=

# ── o1bot wallets (never Privy user wallets; they never sign user launches) ─
TREASURY_ADDRESS=
REFERRER_ADDRESS=

# ── Abuse limits (validator) ──────────────────────────────────────────
MAX_LAUNCHES_PER_USER_PER_DAY=5
LAUNCH_COOLDOWN_SECONDS=600
# Hard cap on the atomic dev buy, in ETH.
MAX_DEV_BUY_ETH=1
# Replies per X account per UTC day (help, questions and errors included).
MAX_REPLIES_PER_USER_PER_DAY=8

# ── Public links shown in the web app (inlined at build time) ─────────
NEXT_PUBLIC_DOCS_URL=https://docs.o1bot.exchange
NEXT_PUBLIC_X_URL=https://x.com/o1bot_exchange
NEXT_PUBLIC_GITHUB_URL=https://github.com/o1bot-exchange
NEXT_PUBLIC_CONTACT_EMAIL=hello@o1bot.exchange

# ── Indexer and market data ───────────────────────────────────────────
# RPC for historical eth_getLogs (paid endpoint recommended). Falls back to RPC_ROBINHOOD.
INDEXER_RPC=
# Poll interval in ms; start/end blocks are optional (end block only for bounded dry runs).
INDEXER_POLL_MS=3000
INDEXER_START_BLOCK=
INDEXER_END_BLOCK=
# Local testing only: track tokens that were not launched by the bot. Format 0xtoken@0xlaunchTxHash.
INDEXER_DEV_TOKENS=
# Show INDEXER_DEV_TOKENS pools in the web app (never in production).
SHOW_DEV_TOKENS=false
# Public IPFS gateway used to render token images and read metadata.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ── o1 Public API (read side only: holder snapshots on token pages) ───
O1_API_URL=https://api.launch.o1.exchange/v1
O1_API_KEY=
