# o1bot.exchange — copy to .env at the repository root (never commit .env).
#
# LOCAL: one file for the whole monorepo. Every entry point (bot, indexer, web,
# Prisma, the simulate and parse scripts) loads this file from the repo root
# whichever package directory it was started from.
#
# PRODUCTION: there is no file. Each host gets only the variables its service
# reads. The tag after every section name says which services that is:
#
#   web       Vercel      the Next.js app
#   bot       Railway     listener → parser → signer → replies
#   indexer   Railway     swaps, prices, candles for the token pages
#   db        your laptop `pnpm db:push` / `pnpm db:migrate` against the production database
#   local     never deployed
#
# Fill this file once, then `pnpm env:split` writes deploy/web.env, deploy/bot.env,
# deploy/indexer.env and deploy/db.env with the values, ready to paste into
# Railway (Variables → Raw Editor) or Vercel (Environment Variables → Import).
# The same value (for example DATABASE_URL) goes to every service that lists it.

# ── Logging · bot, indexer, web ───────────────────────────────────────
LOG_LEVEL=info
# Pretty output is for a terminal; hosts want plain JSON lines (false).
LOG_PRETTY=true

# ── Bot safety · bot ──────────────────────────────────────────────────
# true: parse, validate, simulate, but never sign or reply. Flip to false only
# after a real launch on a fresh wallet with the minimum fee went through.
DRY_RUN=true
# Public URL of the web app; appears in replies, metadata and onboarding links.
SITE_URL=http://localhost:3000
# Docs link the bot may give when someone asks a question. Empty = SITE_URL/how-it-works.
DOCS_URL=

# ── Database (Postgres) · bot, web, indexer, db ───────────────────────
# One database shared by all three services. Railway Postgres or Neon both work.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/o1bot

# ── Queue · bot ───────────────────────────────────────────────────────
# memory: single process, nothing to install. redis: BullMQ on REDIS_URL,
# survives restarts and allows a separate worker. Railway Redis provides REDIS_URL.
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ── Privy server credentials (dashboard.privy.io) · bot, web ─────────
# One Privy app for the web front end and the bot. Enable Login with X
# (Twitter) and Embedded wallets (Ethereum). Wallets run in Privy's TEE, so
# server signing works through a signer: Wallet infrastructure →
# Authorization keys → Create new key gives a key quorum ID and a private key.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The key quorum ID from that dialog. Users add it as a signer on their wallet during onboarding.
PRIVY_SIGNER_ID=
# Policy the signer is bound to, from `pnpm privy:policy`: Privy's enclave then refuses anything
# but launches, fee-recipient updates and claims to the o1 contracts, within value caps. A user
# counts as linked only when the signer on their wallet carries this policy.
PRIVY_POLICY_ID=

# ── Privy signing key · bot ───────────────────────────────────────────
# The private key from the authorization-key dialog ("wallet-auth:..."). Only the bot signs;
# the web app reads wallets with the app secret alone, so keep this off Vercel. A leaked key
# can still only do what PRIVY_POLICY_ID allows.
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# ── X / Twitter (developer.x.com) · bot ───────────────────────────────
# Bearer: read mentions. App user tokens: post replies as @o1bot_exchange
# (Read+Write; regenerate the access token AFTER enabling Write).
X_BEARER_TOKEN=
X_APP_KEY=
X_APP_SECRET=
X_APP_ACCESS_TOKEN=
X_APP_ACCESS_TOKEN_SECRET=
# Numeric id of the bot account:
#   curl -H "Authorization: Bearer $X_BEARER_TOKEN" https://api.x.com/2/users/by/username/o1bot_exchange
X_BOT_USER_ID=
X_BOT_HANDLE=o1bot_exchange
# Mentions poll interval in ms. Pay-per-use bills each mention read ($0.001), not each poll,
# so this only trades latency against X's 15-minute rate limit; a 429 pauses polling until the window resets.
X_POLL_MS=30000

# ── Anthropic (parser, reply localization) · bot ──────────────────────
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-4-6 when empty.
PARSER_MODEL=

# ── IPFS pinning (Pinata JWT) · bot ───────────────────────────────────
PINATA_JWT=

# ── Chain RPC (Robinhood Chain, id 4663) · bot, web, indexer ──────────
# Empty = rotate through public RPCs (publicnode, ordofi, the chain's own
# endpoint). Use a paid RPC in production: the bot needs eth_call with state
# overrides and the indexer needs eth_getLogs over wide ranges, which public
# endpoints throttle or refuse. Some ISPs intercept rpc.mainnet.chain.robinhood.com.
RPC_ROBINHOOD=

# ── Abuse limits (validator) · bot ────────────────────────────────────
MAX_LAUNCHES_PER_USER_PER_DAY=5
LAUNCH_COOLDOWN_SECONDS=600
# Trades from posts ("buy 0.05 ETH of $CAT"). Off per user until enabled on the profile.
# Hard per-trade cap in ETH (a user's own cap can only be lower), the default user cap,
# the gap between two trades per account, the daily count, and the default slippage in bps.
MAX_TRADE_ETH=0.5
DEFAULT_USER_TRADE_CAP_ETH=0.1
TRADE_COOLDOWN_SECONDS=30
MAX_TRADES_PER_USER_PER_DAY=20
TRADE_SLIPPAGE_BPS=300

# ── Bridging from a post · bot ────────────────────────────────────────
# "bridge 0.1 ETH from base" moves ETH from the user's wallet on Base, Ethereum,
# Arbitrum or Optimism to the same wallet on Robinhood through Relay. Public
# RPCs are used for the origin chains unless set here.
MAX_BRIDGE_ETH=1
RELAY_API_URL=https://api.relay.link
# Optional: from Relay's app registration, attributes volume to o1bot for fee sharing.
RELAY_API_KEY=
RPC_BASE=
RPC_ETHEREUM=
RPC_ARBITRUM=
RPC_OPTIMISM=

# ── Alerts · bot ──────────────────────────────────────────────────────
# Telegram message to you whenever a launch or trade fails, X refuses a reply,
# the mention poller keeps failing, or the worker crashes; one line at boot.
# Create a bot with @BotFather for the token; the chat id is your own chat with
# it (send it a message, then read https://api.telegram.org/bot<token>/getUpdates).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Hard cap on the atomic dev buy, in ETH.
MAX_DEV_BUY_ETH=1
# Slippage tolerance on the simulated dev-buy output, in basis points (500 = 5%). o1's UI uses 2500.
DEV_BUY_SLIPPAGE_BPS=500
# Replies per X account per UTC day (help, questions and errors included).
MAX_REPLIES_PER_USER_PER_DAY=8

# ── Public values inlined into the web build · web ────────────────────
# Same Privy app id as PRIVY_APP_ID; this copy is what the browser sees.
NEXT_PUBLIC_PRIVY_APP_ID=
# Same value as PRIVY_SIGNER_ID; the browser passes it to addSigners during onboarding.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Same value as PRIVY_POLICY_ID; attached to the signer in the same addSigners call.
NEXT_PUBLIC_PRIVY_POLICY_ID=
NEXT_PUBLIC_DOCS_URL=https://docs.o1bot.exchange
NEXT_PUBLIC_X_URL=https://x.com/o1bot_exchange
NEXT_PUBLIC_GITHUB_URL=https://github.com/o1Bot/TweetLaunch
NEXT_PUBLIC_CONTACT_EMAIL=hello@o1bot.exchange

# ── o1 Public API · web, bot ──────────────────────────────────────────
# Web: holder snapshots. Bot: asks o1 to pin each launch's logo and
# metadata in o1's own Pinata account (POST /launches/prepare), which is
# the only way o1's token pages show them. Needs the launches:prepare
# scope; without a key the bot pins through PINATA_JWT only and the token
# stays blank on launch.o1.exchange.
O1_API_URL=https://api.launch.o1.exchange/v1
O1_API_KEY=

# ── Token images and metadata · web, indexer ──────────────────────────
# Gateway used first to render token images and read metadata (your
# dedicated Pinata gateway in production). o1's gateway and Pinata's public
# one are tried after it. ipfs.io no longer serves plain HTTP requests.
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Indexer · indexer ─────────────────────────────────────────────────
# RPC for historical eth_getLogs (paid endpoint). Falls back to RPC_ROBINHOOD.
INDEXER_RPC=
INDEXER_POLL_MS=3000
# Optional: first block to scan when the cursor table is empty.
INDEXER_START_BLOCK=

# ── o1bot wallets · web, bot ──────────────────────────────────────────
# Never Privy user wallets; they never sign user launches. Read by the swap
# page (referrer in hook data) and fee claims, which are not built yet.
TREASURY_ADDRESS=
REFERRER_ADDRESS=

# ── Local previews only · local ───────────────────────────────────────
# Track tokens that were NOT launched by the bot, to test the indexer and
# token pages against live pools. Format 0xtoken@0xlaunchTxHash. Never in production.
INDEXER_DEV_TOKENS=
# Stop the indexer at this block (bounded dry runs).
INDEXER_END_BLOCK=
# Show INDEXER_DEV_TOKENS pools in the web app.
SHOW_DEV_TOKENS=false
