# o1bot.exchange — copy to .env at the repository root (never commit .env).
#
# One file for the whole monorepo. Every entry point (bot, indexer, web, Prisma,
# the simulate and parse scripts) loads this file from the repo root whichever
# package directory it was started from. Variables already set in the shell win.
# In production there is no file: set the same names per service on the host
# (Railway: bot, indexer; Vercel: web). The tag after each section name says
# which services read it.
#
#   bot      DRY_RUN SITE_URL DATABASE_URL QUEUE_DRIVER REDIS_URL PRIVY_APP_ID
#            PRIVY_APP_SECRET X_* ANTHROPIC_API_KEY PARSER_MODEL PINATA_JWT
#            RPC_ROBINHOOD MAX_* LAUNCH_COOLDOWN_SECONDS
#   web      SITE_URL DATABASE_URL PRIVY_APP_ID PRIVY_APP_SECRET NEXT_PUBLIC_*
#            RPC_ROBINHOOD O1_API_URL O1_API_KEY IPFS_GATEWAY SHOW_DEV_TOKENS
#   indexer  DATABASE_URL INDEXER_* RPC_ROBINHOOD
#   db       DATABASE_URL (prisma migrate / db push)
#
# The bot boots in DRY_RUN=true by default: parse, validate, simulate, but never sign or reply.

# ── Safety · bot, web ─────────────────────────────────────────────────
DRY_RUN=true
SITE_URL=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true

# ── Storage · bot, web, indexer, db ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/o1bot
# memory (default, single process) or redis (BullMQ; needs REDIS_URL). Bot only.
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ── Privy (dashboard.privy.io) · bot, web ─────────────────────────────
# Same app for the web front end and the bot. Enable: Login with X (Twitter),
# Embedded wallets (Ethereum), and Delegated actions (server signing consent).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# ── X / Twitter (developer.x.com) · bot ───────────────────────────────
# Bearer: read mentions. App user tokens: post replies as @o1bot_exchange
# (Read+Write; regenerate the access token AFTER enabling Write).
X_BEARER_TOKEN=
X_APP_KEY=
X_APP_SECRET=
X_APP_ACCESS_TOKEN=
X_APP_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=o1bot_exchange
# Mentions poll interval in ms. 90 s keeps a Basic-tier app inside its 10 requests / 15 min budget.
X_POLL_MS=90000

# ── Anthropic (parser, reply localization) · bot ──────────────────────
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-4-6 when empty.
PARSER_MODEL=

# ── IPFS (Pinata) · bot ───────────────────────────────────────────────
PINATA_JWT=

# ── Chain (v1 = Robinhood Chain, id 4663) · bot, web, indexer ─────────
# Leave empty to rotate through public RPCs (publicnode, ordofi, the chain's
# own endpoint). Set a paid RPC for production; public ones refuse archive
# log queries and some ISPs intercept rpc.mainnet.chain.robinhood.com.
RPC_ROBINHOOD=

# ── o1bot wallets (never Privy user wallets; they never sign user launches) · web ─
TREASURY_ADDRESS=
REFERRER_ADDRESS=

# ── Abuse limits (validator) · bot ────────────────────────────────────
MAX_LAUNCHES_PER_USER_PER_DAY=5
LAUNCH_COOLDOWN_SECONDS=600
# Hard cap on the atomic dev buy, in ETH.
MAX_DEV_BUY_ETH=1
# Slippage tolerance on the simulated dev-buy output, in basis points (500 = 5%). o1's UI uses 2500.
DEV_BUY_SLIPPAGE_BPS=500
# Replies per X account per UTC day (help, questions and errors included).
MAX_REPLIES_PER_USER_PER_DAY=8

# ── Public links shown in the web app (inlined at build time) · web ───
NEXT_PUBLIC_DOCS_URL=https://docs.o1bot.exchange
NEXT_PUBLIC_X_URL=https://x.com/o1bot_exchange
NEXT_PUBLIC_GITHUB_URL=https://github.com/o1Bot/TweetLaunch
NEXT_PUBLIC_CONTACT_EMAIL=hello@o1bot.exchange

# ── Indexer and market data · indexer, web ────────────────────────────
# RPC for historical eth_getLogs (paid endpoint recommended). Falls back to RPC_ROBINHOOD.
INDEXER_RPC=
# Poll interval in ms; start/end blocks are optional (end block only for bounded dry runs).
INDEXER_POLL_MS=3000
INDEXER_START_BLOCK=
INDEXER_END_BLOCK=
# Local testing only: track tokens that were not launched by the bot. Format 0xtoken@0xlaunchTxHash.
INDEXER_DEV_TOKENS=
# Show INDEXER_DEV_TOKENS pools in the web app (never in production).
SHOW_DEV_TOKENS=false
# Public IPFS gateway used to render token images and read metadata.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ── o1 Public API (read side only: holder snapshots on token pages) · web ─
O1_API_URL=https://api.launch.o1.exchange/v1
O1_API_KEY=
