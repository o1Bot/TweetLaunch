// o1bot.exchange — users, mentions, launches, signed-transaction audit log.
// Amounts are stored as decimal strings (wei), never as floats.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per X account that has touched o1bot: either logged in on the web
/// app, or been named as a `fees to` recipient (pregenerated wallet).
model User {
  id            String    @id @default(cuid())
  /// Stable X user ID (the OAuth `sub`). Handles change; this does not.
  xUserId       String    @unique
  xHandle       String
  xName         String?
  xAvatarUrl    String?
  privyUserId   String?   @unique
  /// Privy embedded wallet address (checksummed).
  walletAddress String?   @unique
  /// Privy server-wallet ID, required for bot-side signing.
  walletId      String?
  /// True while the wallet exists only because someone said `fees to @them`.
  pregenerated  Boolean   @default(false)
  /// True once the user granted delegated signing to o1bot in the web app.
  delegated     Boolean   @default(false)
  /// First successful X login on o1bot.exchange.
  linkedAt      DateTime?
  /// Opt-in for buy/sell commands from posts; off until the user enables it on the profile.
  tradingEnabled Boolean  @default(false)
  /// The user's own per-trade cap in wei (decimal string); null = the deployment default.
  maxTradeWei   String?
  /// Whether other people's launches may direct creator fees to this account.
  acceptFeeRedirects Boolean @default(true)
  /// "auto" answers in the language of the post; "en" always answers in English.
  replyLanguage String   @default("auto")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  launches       Launch[] @relation("LaunchCreator")
  feeRecipientOf Launch[] @relation("LaunchFeeRecipient")
  trades         Trade[]
  bridges        Bridge[]

  @@index([xHandle])
}

enum MentionStatus {
  RECEIVED
  PARSED
  CLARIFY
  NOT_REGISTERED
  REJECTED
  QUEUED
  DONE
  FAILED
}

/// Every mention of the bot, deduped by tweet ID.
model Mention {
  id            String        @id @default(cuid())
  tweetId       String        @unique
  authorXUserId String
  authorHandle  String
  text          String
  mediaUrl      String?
  language      String?
  postedAt      DateTime?
  receivedAt    DateTime      @default(now())
  /// Parser output (LaunchCommand or clarify question), verbatim.
  parse         Json?
  status        MentionStatus @default(RECEIVED)
  error         String?
  replyTweetId  String?

  launch Launch?

  trade Trade?

  bridge Bridge?

  @@index([authorXUserId, receivedAt])
  @@index([status])
}

enum LaunchStatus {
  DRY_RUN
  QUEUED
  SIMULATING
  SIGNING
  BROADCAST
  CONFIRMED
  FEE_RECIPIENT_PENDING
  REPLIED
  FAILED
}

enum LaunchSource {
  /// Command posted on X and picked up by the listener.
  X
  /// Form on the web app; the bot worker processes it the same way.
  WEB
}

model Launch {
  id             String       @id @default(cuid())
  source         LaunchSource @default(X)
  /// The originating post for X launches; null for web launches.
  mentionId      String?      @unique
  mention        Mention?     @relation(fields: [mentionId], references: [id])
  creatorId      String
  creator        User         @relation("LaunchCreator", fields: [creatorId], references: [id])
  feeRecipientId String?
  feeRecipient   User?        @relation("LaunchFeeRecipient", fields: [feeRecipientId], references: [id])
  chainId        Int
  /// Originating factory. Historical launches keep the factory they used.
  factory        String
  quoteAddress   String
  quoteSymbol    String
  ticker         String
  name           String
  /// Dev buy in wei of the native asset, decimal string. Null = no dev buy.
  devBuyWei      String?
  imageUri       String?
  metadataUri    String?
  creatorSalt    String?
  status         LaunchStatus @default(QUEUED)
  tokenAddress   String?
  poolId         String?
  launchTxHash   String?
  feeRecipientTxHash String?
  /// Internal error detail for operators.
  error          String?
  /// What the user is told about the outcome (the reply text for X launches).
  userMessage    String?
  /// Web launches: the form as submitted (description, links, fees-to handle, dev buy) until processed.
  request        Json?
  /// Web launches: uploaded logo bytes until the worker pins them, then cleared.
  imageData      Bytes?
  imageMime      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  signedTxs SignedTransaction[]
  pool      Pool?

  @@index([creatorId, createdAt])
  @@index([chainId, tokenAddress])
  @@index([status])
  @@index([source, status, createdAt])
}

enum SignedTxKind {
  CREATE_LAUNCH
  CREATE_LAUNCH_AND_BUY
  ERC20_APPROVE
  SET_CREATOR_FEE_RECIPIENT
  FEE_CLAIM
  PERMIT2_APPROVE
  ROUTER_EXECUTE
  RELAY_DEPOSIT
}

enum BridgeStatus {
  DRY_RUN
  QUEUED
  SIGNING
  DEPOSITED
  FILLED
  FAILED
}

/// ETH moved from the user's wallet on another chain to the same wallet on
/// Robinhood through Relay, asked for in a post.
model Bridge {
  id            String       @id @default(cuid())
  mentionId     String?      @unique
  mention       Mention?     @relation(fields: [mentionId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  originChainId Int
  /// Wei deposited on the origin chain.
  amountInWei   String
  /// Wei Relay quoted for delivery on Robinhood.
  amountOutWei  String?
  requestId     String?
  depositTxHash String?
  fillTxHash    String?
  status        BridgeStatus @default(QUEUED)
  error         String?
  userMessage   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, createdAt])
}

enum TradeStatus {
  DRY_RUN
  QUEUED
  SIGNING
  CONFIRMED
  REPLIED
  FAILED
}

/// A buy or sell asked for in a post and executed from the poster's wallet
/// through the Universal Router into an o1 launch pool. The indexer records
/// the resulting swap separately (Swap); this row is the request and its outcome.
model Trade {
  id            String      @id @default(cuid())
  mentionId     String?     @unique
  mention       Mention?    @relation(fields: [mentionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  chainId       Int
  token         String
  /// Symbols and quote decimals as known at trade time, so history renders without a Pool row (o1-directory tokens).
  tokenSymbol   String?
  quoteSymbol   String?
  quoteDecimals Int?
  side          SwapSide
  /// Raw units of the input currency (quote units for buys, token units for sells).
  amountInWei   String
  minAmountOut  String?
  amountOut     String?
  slippageBps   Int
  status        TradeStatus @default(QUEUED)
  txHash        String?
  error         String?
  userMessage   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([token, createdAt])
}

/// Append-only audit of everything the bot signed with a user wallet.
model SignedTransaction {
  id           String       @id @default(cuid())
  launchId     String?
  launch       Launch?      @relation(fields: [launchId], references: [id])
  tweetId      String
  xUserId      String
  wallet       String
  chainId      Int
  kind         SignedTxKind
  to           String
  /// keccak256 of the calldata.
  calldataHash String
  valueWei     String
  txHash       String?
  createdAt    DateTime     @default(now())

  @@index([xUserId, createdAt])
  @@index([tweetId])
}

/// Persisted scan cursor per indexer source (crash-safe resume).
model IndexerCursor {
  id          String   @id
  blockNumber BigInt
  updatedAt   DateTime @updatedAt
}

enum PoolSource {
  BOT
  DEV
}

/// A launch pool the indexer tracks. Only tokens launched through o1bot are
/// inserted (plus DEV rows listed in INDEXER_DEV_TOKENS for local testing),
/// so the UI never shows other o1 tokens.
model Pool {
  token            String     @id
  poolId           String     @unique
  chainId          Int
  factory          String
  hook             String
  quoteAddress     String
  quoteSymbol      String
  quoteDecimals    Int
  tokenIsCurrency0 Boolean
  tickSpacing      Int
  creatorWallet    String
  /// Raw units (18 decimals).
  launchSupply     Decimal    @db.Decimal(78, 0)
  launchBlock      BigInt
  launchTxHash     String
  launchedAt       DateTime
  name             String
  symbol           String
  imageUri         String?
  metadataUri      String?
  source           PoolSource @default(BOT)
  launchId         String?    @unique
  launch           Launch?    @relation(fields: [launchId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  swaps Swap[]

  @@index([launchedAt])
}

enum SwapSide {
  BUY
  SELL
}

/// One Uniswap v4 swap on a tracked pool. id = txHash-logIndex (idempotent).
model Swap {
  id           String   @id
  token        String
  pool         Pool     @relation(fields: [token], references: [token])
  poolId       String
  blockNumber  BigInt
  txHash       String
  logIndex     Int
  timestamp    DateTime
  /// Transaction sender (the wallet), not the router.
  trader       String
  side         SwapSide
  /// Raw token units (18 decimals).
  amountToken  Decimal  @db.Decimal(78, 0)
  /// Raw quote units.
  amountQuote  Decimal  @db.Decimal(78, 0)
  /// Quote per token in human units, after the swap.
  priceQuote   Decimal  @db.Decimal(60, 18)
  sqrtPriceX96 Decimal  @db.Decimal(78, 0)
  referrer     String?
  /// Hook fee in the quote currency, raw units.
  feeQuote     Decimal? @db.Decimal(78, 0)
  comment      String?

  @@index([token, timestamp])
  @@index([timestamp])
}

/// Small key/value state for the bot (X since_id, last poll time).
model BotCursor {
  id        String   @id
  value     String
  updatedAt DateTime @updatedAt
}
