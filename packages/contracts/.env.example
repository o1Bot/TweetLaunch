# Everything the fee splitter needs, in one place. Copy to packages/contracts/.env
# and fill it in; `pnpm contracts:deploy <chain>` reads this file first, then the
# root .env for whatever is missing (the RPC, for one). Nothing here goes to a host.

# ── Deployment (your machine only) ─────────────────────────────────────
# Private key (0x…) of the wallet that pays the deployment gas. It needs a
# little of the chain's gas asset: ETH on Robinhood and Base, USDC on Arc.
# Deploying costs about 2.7M gas per chain.
FEE_SPLITTER_DEPLOYER_KEY=

# Wallet that receives the platform share of creator fees (buyback and burn).
# The same address works on every chain. It must be able to receive ETH, USDG,
# stock tokens and, on Arc, USDC. Never the bot's signer.
FEE_SPLITTER_TREASURY=

# Owner of the factories: may change the treasury, the platform share for
# launches registered later (cap 30%), and sweep what nobody is owed. A hardware
# wallet or a multisig. Empty = the deployer wallet above.
FEE_SPLITTER_OWNER=

# Platform share of the creator fees for launches registered from now on, in
# basis points of the creator's half of the swap fee: 2000 = 20%. Maximum 3000.
FEE_SPLITTER_PLATFORM_BPS=2000

# ── RPC per chain (falls back to the root .env, then the public lists) ─
# Only needed here if you want the deployment to use a different endpoint than
# the bot does.
RPC_ROBINHOOD=
RPC_BASE=
RPC_ARC=

# ── After deployment ───────────────────────────────────────────────────
# `pnpm contracts:deploy <chain> --broadcast` prints the factory address. Put
# it in the ROOT .env (and on Railway for the bot, Vercel for the web); the
# apps read it from there, not from this file:
#   FEE_SPLITTER_FACTORY_ROBINHOOD=0x…
#   FEE_SPLITTER_FACTORY_BASE=0x…
#   FEE_SPLITTER_FACTORY_ARC=0x…
